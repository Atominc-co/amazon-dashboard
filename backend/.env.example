PORT=4000
NODE_ENV=development

# DataDoe REST API
# Base URL confirmed from https://app.datadoe.com/integrations/rest-api OpenAPI spec (server: https://api.datadoe.com)
DATADOE_API_BASE_URL=https://api.datadoe.com
# Required header on every non-spec request: datadoe-api-key
# Generate/rotate at https://app.datadoe.com/integrations/rest-api (key name: amazon-executive-dashboard-dev, prefix: dd_api_)
# DO NOT commit the real value. Paste the actual key into backend/.env only (never into chat/logs).
DATADOE_API_KEY=

# Optional. Leave unset for local development (CORS stays wide open, current behavior).
# In production, set to the deployed frontend's exact origin, e.g. https://dashboard.example.com
# (placeholder only — replace with the real production frontend domain at deploy time).
CORS_ALLOWED_ORIGIN=
